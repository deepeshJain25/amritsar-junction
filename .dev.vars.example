# Local settings for the ordering Worker. Copy to .dev.vars (git-ignored).
# `npm run build && npx wrangler dev` reads .dev.vars; it overrides the "vars" in wrangler.jsonc.

# Fake payments so the whole flow can be tried locally. Mock orders never reach the POS.
# Set it to false to pay through the POS for real: card payments then use the Stripe keys set in the POS admin,
# and every paid order is placed in the POS and can print a docket. Never set this in production.
MOCK_PAYMENTS=true
