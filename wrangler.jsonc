// Used by Cloudflare Workers Builds: every push to main on GitHub runs `npm run build`, then `npx wrangler deploy`.
// Serves the static Astro build from dist/ as the amritsar-junction Worker
// (https://amritsar-junction.anzunited.workers.dev), with the ordering Worker (worker/index.ts) in front of
// /api/* and /order/*. Setup and local testing: docs/ordering.md.
// Keep name, compatibility date and observability in step with deploy/cloudflare.config.ts, used by `npm run deploy`.
{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "amritsar-junction",
  "main": "worker/index.ts",
  "compatibility_date": "2026-11-04",
  "assets": {
    "directory": "./dist",
    "binding": "ASSETS",
    "run_worker_first": ["/api/*", "/order/*"]
  },
  // Orders, in the D1 database amritsar-junction-orders (created 26 Nov 2026, Oceania).
  // New migrations: `npx wrangler d1 migrations apply amritsar-junction-orders --remote`.
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "amritsar-junction-orders",
      "database_id": "162429a8-253a-4e32-9d18-92f04d0410b6",
      "migrations_dir": "migrations"
    }
  ],
  // The POS the Worker charges cards through and sends orders to. Its Stripe keys are set in the POS admin, not here.
  "vars": {
    "STOREFRONT_API_URL": "https://dev.chaseintel.com.au/api",
    "RESTAURANT_ID": "da070da6-42ad-4722-be8d-30a32a80bd41"
  },
  "observability": {
    "enabled": true
  }
}
