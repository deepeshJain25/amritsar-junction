---
// A menu row set like a contents page: name, dotted leader, price, and an italic description beneath.
// The menu sheet has no prices yet, so the price slot stays empty until they are added to menu.json.
export interface Dish {
  name: string;
  desc: string;
  veg: boolean;
  native?: string;
  options?: string;
  price?: string;
}

interface Props {
  dish: Dish;
}

const { dish } = Astro.props;
---

<li class="aj-item" data-nonveg={dish.veg ? undefined : ''}>
  <h3 class="aj-item__line">
    <span>{dish.name}</span>
    {dish.native && <span class="aj-item__native" lang="pa">{dish.native}</span>}
    <span class="aj-item__leader" aria-hidden="true"></span>
    {dish.price && <span class="aj-item__price">{dish.price}</span>}
  </h3>
  <p class="aj-item__desc">{dish.desc}</p>
  {(dish.veg || dish.options) && (
    <div class="aj-item__meta">
      {dish.veg && <span class="aj-tag">Veg</span>}
      {dish.options && <span class="aj-tag aj-tag--opt">{dish.options}</span>}
    </div>
  )}
</li>
