---
// A grid of MenuCards: one column on phones, two from md, three from lg.
interface Props {
  class?: string;
}

const { class: extra } = Astro.props;
---

<ul class:list={['menu-grid', extra]} role="list">
  <slot />
</ul>

<style>
  .menu-grid { display: grid; grid-template-columns: minmax(0, 1fr); gap: var(--space-5); align-items: start; }
  @media (min-width: 640px) { .menu-grid { grid-template-columns: repeat(2, minmax(0, 1fr)); } }
  @media (min-width: 1024px) { .menu-grid { grid-template-columns: repeat(3, minmax(0, 1fr)); gap: var(--grid-gutter); } }
</style>
