---
import { Picture } from 'astro:assets';

// A photograph with an optional italic caption, served as AVIF/WebP at the sizes the layout needs.
// `aspect` crops it (e.g. "4 / 5"); `radius` follows the crop table in the design spec.
interface Props {
  src: ImageMetadata;
  alt: string;
  caption?: string;
  aspect?: string;
  radius?: 'none' | 'md' | 'lg' | 'lg-top';
  sizes?: string;
  eager?: boolean;
  class?: string;
}

const { src, alt, caption, aspect, radius = 'none', sizes = '(min-width: 1024px) 50vw, 100vw', eager = false, class: extra } = Astro.props;
const widths = [360, 540, 720, 960, 1200, 1600].filter((w) => w <= src.width).concat(src.width > 1600 ? [] : [src.width]);
---

<figure
  class:list={['photo', `photo--${radius}`, aspect && 'photo--cropped', extra]}
  style={aspect ? `--photo-aspect: ${aspect}` : undefined}
>
  <div class="photo__frame">
    <Picture
      src={src}
      alt={alt}
      formats={['avif', 'webp']}
      widths={[...new Set(widths)]}
      sizes={sizes}
      loading={eager ? 'eager' : 'lazy'}
      fetchpriority={eager ? 'high' : undefined}
      decoding="async"
    />
  </div>
  {caption && <figcaption class="text-caption photo__caption">{caption}</figcaption>}
</figure>

<style>
  .photo { margin: 0; }
  .photo__frame { overflow: hidden; background: var(--surface-sunken); }
  .photo :global(img) { width: 100%; height: auto; transition: transform var(--duration-base) var(--ease-out); }
  .photo--cropped .photo__frame { position: relative; aspect-ratio: var(--photo-aspect); }
  .photo--cropped :global(img) { position: absolute; inset: 0; height: 100%; object-fit: cover; }
  .photo--md .photo__frame { border-radius: var(--radius-md); }
  .photo--lg .photo__frame { border-radius: var(--radius-lg); }
  .photo--lg-top .photo__frame { border-radius: var(--radius-lg) var(--radius-lg) 0 0; }
  .photo__caption { margin-top: var(--space-3); color: var(--ctx-ink-muted); }
</style>
