---
import { Picture } from 'astro:assets';

// A photograph with a caption underneath, served as AVIF/WebP at the sizes the layout needs.
interface Props {
  src: ImageMetadata;
  alt: string;
  caption?: string;
  shape?: 'arch' | 'wide' | 'natural';
  sizes?: string;
  eager?: boolean;
  class?: string;
}

const { src, alt, caption, shape = 'natural', sizes = '(max-width: 860px) 100vw, 58vw', eager = false, class: extra } = Astro.props;
const widths = [360, 540, 720, 960, 1200].filter((w) => w <= src.width).concat(src.width > 1200 ? [] : [src.width]);
---

<figure class:list={['aj-figure', shape === 'arch' && 'aj-arch', shape === 'wide' && 'aj-wide', extra]}>
  <Picture
    src={src}
    alt={alt}
    formats={['avif', 'webp']}
    widths={[...new Set(widths)]}
    sizes={sizes}
    loading={eager ? 'eager' : 'lazy'}
    fetchpriority={eager ? 'high' : undefined}
    decoding="async"
  />
  {caption && <figcaption class="aj-caption">{caption}</figcaption>}
</figure>
