---
import site from '../content/site.json';
import Todo from './Todo.astro';
---

<dl class="hours text-body-sm">
  {site.hours.map((h) => (
    <>
      <dt>{h.days}</dt>
      <dd class="text-tabular"><Todo text={h.time} /></dd>
    </>
  ))}
</dl>

<style>
  .hours { display: grid; grid-template-columns: auto auto; gap: var(--space-2) var(--space-5); justify-content: start; }
  .hours dd { margin: 0; text-align: right; white-space: nowrap; }
</style>
