---
import { getImage } from 'astro:assets';
import OrderUI from '../components/order/OrderUI.astro';
import Footer from '../components/ui/Footer.astro';
import Nav from '../components/ui/Nav.astro';
import site from '../content/site.json';
import { breadcrumbSchema, restaurantSchema } from '../lib/seo';
import defaultShare from '../assets/photos/tandoor-skewers.jpg';
import '../styles/global.css';

interface Props {
  title: string;
  description: string;
  /** Breadcrumb name for inner pages; leave out on the home page. */
  crumb?: string;
  /** Extra JSON-LD objects for this page. */
  schema?: object[];
  /** Photo for social sharing previews. */
  share?: ImageMetadata;
  home?: boolean;
  /** "overlay" when the page opens on a full-bleed photo hero marked data-hero. */
  nav?: 'overlay' | 'solid';
  /** Keep the page out of search engines (test and internal pages). */
  noindex?: boolean;
}

const { title, description, crumb, schema = [], share = defaultShare, home = false, nav = 'solid', noindex = false } = Astro.props;
const siteUrl = Astro.site ?? new URL(Astro.url.origin);
const canonical = new URL(Astro.url.pathname, siteUrl).href;
const og = await getImage({ src: share, width: 1200, format: 'jpg' });
const ogUrl = new URL(og.src, siteUrl).href;
// The AJ monogram on maroon; the ornate badge is print-only and never used on the web.
const logoUrl = new URL('/favicon-512.png', siteUrl).href;
const fullTitle = home ? title : `${title} | ${site.name}`;
const fonts =
  'https://fonts.googleapis.com/css2?family=Fraunces:ital,opsz,wght,SOFT,WONK@0,9..144,300..600,50,0..1;1,9..144,300..600,50,0..1&family=Inter:wght@400..600&family=Noto+Sans+Gurmukhi:wght@400..500&display=swap';

const graph = [
  restaurantSchema(siteUrl, ogUrl, logoUrl),
  ...(crumb ? [breadcrumbSchema(siteUrl, [{ name: crumb, path: Astro.url.pathname }])] : []),
  ...schema,
];
---

<!doctype html>
<html lang="en-AU">
  <head>
    <meta charset="utf-8" />
    <script is:inline>document.documentElement.classList.add('js');</script>
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{fullTitle}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonical} />
    <meta name="robots" content={noindex ? 'noindex, nofollow' : 'index, follow, max-image-preview:large'} />
    <meta name="theme-color" content="#6B1F2B" />
    <link rel="icon" href="/favicon.ico" sizes="16x16 32x32 48x48" />
    <link rel="icon" href="/favicon-32.png" type="image/png" sizes="32x32" />
    <link rel="icon" href="/favicon-16.png" type="image/png" sizes="16x16" />
    <link rel="icon" href="/favicon-96.png" type="image/png" sizes="96x96" />
    <link rel="apple-touch-icon" href="/apple-touch-icon.png" />
    <link rel="manifest" href="/site.webmanifest" />
    <link rel="sitemap" href="/sitemap-index.xml" />

    <meta property="og:type" content="restaurant" />
    <meta property="og:site_name" content={site.name} />
    <meta property="og:locale" content="en_AU" />
    <meta property="og:title" content={fullTitle} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta property="og:image" content={ogUrl} />
    <meta property="og:image:width" content={String(og.attributes.width ?? 1200)} />
    <meta property="og:image:height" content={String(og.attributes.height ?? 630)} />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={fullTitle} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={ogUrl} />

    {graph.map((item) => <script is:inline type="application/ld+json" set:html={JSON.stringify(item)} />)}

    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <!-- Fonts load without blocking the first paint: text shows in the fallback stack, then swaps. -->
    <link rel="preload" as="style" href={fonts} />
    <link rel="stylesheet" href={fonts} media="print" onload="this.media='all'" />
    <noscript><link rel="stylesheet" href={fonts} /></noscript>
  </head>
  <body>
    <a class="skip-link" href="#main">Skip to content</a>
    <Nav mode={nav} />
    <main id="main">
      <slot />
    </main>
    <Footer />
    <OrderUI />
    <script>
      // Section reveals: mark what is already on screen as shown, then fade the rest in as it scrolls into view.
      const targets = [...document.querySelectorAll<HTMLElement>('[data-reveal]')];
      if (targets.length && 'IntersectionObserver' in window && !matchMedia('(prefers-reduced-motion: reduce)').matches) {
        const inView = (el: HTMLElement) => el.getBoundingClientRect().top < window.innerHeight;
        targets.filter(inView).forEach((el) => el.classList.add('is-revealed'));
        const observer = new IntersectionObserver((entries) => {
          entries.forEach((entry) => {
            if (!entry.isIntersecting) return;
            entry.target.classList.add('is-revealed');
            observer.unobserve(entry.target);
          });
        }, { rootMargin: '0px 0px -10% 0px' });
        targets.filter((el) => !el.classList.contains('is-revealed')).forEach((el) => observer.observe(el));
        document.documentElement.classList.add('reveal-ready');
      }
    </script>
  </body>
</html>
