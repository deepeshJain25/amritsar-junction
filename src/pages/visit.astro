---
import Hours from '../components/Hours.astro';
import Todo from '../components/Todo.astro';
import FeatureBlock from '../components/sections/FeatureBlock.astro';
import Hero from '../components/sections/Hero.astro';
import SectionOpener from '../components/sections/SectionOpener.astro';
import Button from '../components/ui/Button.astro';
import site from '../content/site.json';
import Layout from '../layouts/Layout.astro';
import { confirmed } from '../lib/seo';
import dal from '../assets/photos/dal-makhani.jpg';
import saag from '../assets/photos/sarson-ka-saag.jpg';

// The map searches by the full address once it is confirmed, and by the restaurant's name until then.
const mapSearch = confirmed(site.address) ? `${site.name}, ${site.address}` : site.mapQuery;
const mapEmbed = `https://www.google.com/maps?q=${encodeURIComponent(mapSearch)}&output=embed`;
// "Get directions" opens the restaurant's own Google Maps pin.
const directions = site.mapUrl;

// Ways to order. Pickup only: the restaurant doesn't deliver yet (see ordering.delivery.enabled).
// A link still in [square brackets] shows highlighted and gets no button until it is confirmed.
const partners = [
  { name: 'Order online', note: 'Choose your dishes, pay by card and pick a time. It will be hot when you arrive.', href: site.orderUrl, cta: 'Start your order' },
  { name: 'Call to order', note: 'Tell us what you would like and when. Call ahead and it will be hot when you arrive.', href: site.phoneHref, cta: 'Call to order' },
];
---

<Layout
  nav="overlay"
  title="Visit & Reserve a Table"
  description={`Find Amritsar Junction: address, opening hours, phone, parking and directions. Book a table or order takeaway from our Punjabi restaurant in ${confirmed(site.suburb) ?? 'Sydney'}.`}
  crumb="Visit & Reserve"
  share={saag}
>
  <Hero image={saag} alt="Sarson ka saag topped with white butter, with makki di roti, radish and jaggery" eyebrow="Visit & reserve" title="Find us, book a table, order in" standfirst="Walk in, or call ahead to book a table. Either way, there will be hot kulchas waiting." />

  <section class="section" id="reserve" aria-labelledby="reserve-title">
    <div class="container reserve">
      <div class="reserve__form">
        <SectionOpener eyebrow="Reserve a table" title="Book your table" standfirst="Call us to book. Tell us the day, the time and how many of you are coming, and we will hold your table." size="md" id="reserve-title" />
        <div class="call-to-book">
          <p class="eyebrow text-meta">Call to book</p>
          <a class="call-to-book__number text-tabular" href={site.phoneHref}><Todo text={site.phone} /></a>
          <p class="text-body-sm call-to-book__note">Bookings are by phone only. Let us know about birthdays, high chairs or allergies when you call.</p>
          <Button href={site.phoneHref}>Call to book a table</Button>
        </div>
        <div class="reserve__hours">
          <h3 class="eyebrow text-meta">Hours</h3>
          <Hours />
          <p class="text-body-sm reserve__muted"><Todo text="[Public holiday hours may differ. Call ahead.]" /></p>
        </div>
      </div>

      <div class="reserve__place">
        <div class="map" data-map={mapEmbed} data-map-title={`Map showing ${site.name}`}>
          <a class="map__fallback text-body-sm" href={directions} target="_blank" rel="noopener">Open the map in Google Maps</a>
          <span class="map__pin" aria-hidden="true"></span>
        </div>
        <dl class="facts">
          <div>
            <dt class="eyebrow text-meta">Address</dt>
            <dd><address><Todo text={site.address} /></address><Button variant="tertiary" href={directions} target="_blank" rel="noopener">Get directions</Button></dd>
          </div>
          <div>
            <dt class="eyebrow text-meta">Phone</dt>
            <dd><a href={site.phoneHref}><Todo text={site.phone} /></a></dd>
          </div>
          <div>
            <dt class="eyebrow text-meta">Parking</dt>
            <dd><Todo text={site.parking} /></dd>
          </div>
          <div>
            <dt class="eyebrow text-meta">Public transport</dt>
            <dd><Todo text={site.transport} /></dd>
          </div>
        </dl>
      </div>
    </div>
  </section>

  <section class="section surface-sunken" id="order" aria-labelledby="order-title">
    <div class="container">
      <SectionOpener eyebrow="Takeaway" title="Order for pickup" standfirst="We don't deliver yet. Order ahead and collect from our door." size="md" align="center" id="order-title" />
      <ul class="partners" role="list">
        {partners.map((p) => (
          <li class="partner">
            <h3 class="text-heading-md">{p.name}</h3>
            <p class="text-body-sm partner__note">{p.note}</p>
            {confirmed(p.href)
              ? <Button variant="secondary" href={p.href}>{p.cta}</Button>
              : <p class="text-body-sm"><Todo text={p.href} /></p>}
          </li>
        ))}
      </ul>
    </div>
  </section>

  <section class="section" aria-labelledby="private-title">
    <div class="container">
      <FeatureBlock image={dal} alt="A ladle lifting creamy dal makhani from a black bowl, swirled with cream and coriander" side="right" eyebrow="Private dining" title="The whole room, for your table" id="private-title">
        <p>Birthdays, engagements, a family that has not all been in one place for years: for groups of more than 12, or to book the whole room, call us and we will plan the evening with you.</p>
        <p>We can set a shared Punjabi menu so the food keeps coming to the middle of the table, the way it does at home.</p>
        <Button slot="actions" href={site.phoneHref}>Call to plan</Button>
        <Button slot="actions" variant="tertiary" href="/catering/">Catering and events</Button>
      </FeatureBlock>
    </div>
  </section>
</Layout>

<script>
  // The Google Maps embed is about 1 MB, so it loads after the page has; until then, and without JavaScript, a link stands in.
  const map = document.querySelector<HTMLElement>('[data-map]');
  const embed = () => {
    if (!map) return;
    const frame = document.createElement('iframe');
    frame.src = map.dataset.map!;
    frame.title = map.dataset.mapTitle!;
    frame.referrerPolicy = 'no-referrer-when-downgrade';
    frame.allowFullscreen = true;
    map.prepend(frame);
    map.classList.add('has-map');
  };
  if (document.readyState === 'complete') setTimeout(embed, 0);
  else window.addEventListener('load', () => setTimeout(embed, 0), { once: true });
</script>

<style>
  .reserve { display: grid; grid-template-columns: minmax(0, 1fr); gap: var(--space-9); align-items: start; }
  @media (min-width: 1024px) { .reserve { grid-template-columns: 7fr 5fr; gap: var(--space-9); } }
  .reserve__hours { margin-top: var(--space-8); padding-top: var(--space-6); border-top: 1px solid var(--line-primary); }
  .reserve__hours h3 { display: flex; margin-bottom: var(--space-4); }
  .reserve__muted { margin-top: var(--space-4); color: var(--ink-secondary); }

  /* A muted map, its own pin covered by a gold one at the centre. */
  .map { position: relative; aspect-ratio: 4 / 5; overflow: hidden; border-radius: var(--radius-lg); background: var(--surface-sunken); }
  .map :global(iframe) { position: absolute; inset: 0; width: 100%; height: 100%; border: 0; filter: grayscale(1) sepia(0.25) contrast(0.9) brightness(1.05); }
  .map__fallback { position: absolute; left: 50%; bottom: var(--space-6); translate: -50% 0; display: inline-flex; align-items: center; min-height: var(--touch-target); padding-inline: var(--space-5); background: var(--surface-raised); border-radius: var(--radius-pill); color: var(--ink-primary); white-space: nowrap; }
  .map.has-map .map__fallback { display: none; }
  .map__pin { position: absolute; left: 50%; top: 50%; width: 28px; height: 28px; translate: -50% -100%; background: var(--brand-gold); border: 3px solid var(--surface-raised); border-radius: 50% 50% 50% 0; rotate: -45deg; box-shadow: var(--elev-2); pointer-events: none; }
  .facts { display: grid; gap: var(--space-6); margin-top: var(--space-7); }
  .facts dt { display: flex; }
  .facts dd { margin: 0; }
  .facts address { font-style: normal; overflow-wrap: anywhere; }
  .facts a:not(.btn) { display: inline-flex; align-items: center; min-height: var(--touch-target); color: var(--ink-primary); overflow-wrap: anywhere; }

  .partners { display: grid; grid-template-columns: minmax(0, 1fr); gap: var(--space-5); }
  @media (min-width: 768px) { .partners { grid-template-columns: repeat(2, minmax(0, 1fr)); gap: var(--grid-gutter); max-width: 880px; margin-inline: auto; } }
  .partner { display: grid; gap: var(--space-4); justify-items: start; align-content: start; padding: var(--space-6) var(--space-5); background: var(--surface-raised); border-radius: var(--radius-lg); box-shadow: var(--elev-inset); }
  .partner__note { color: var(--ink-secondary); }
</style>
