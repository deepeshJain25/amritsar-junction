---
import Hero from '../components/sections/Hero.astro';
import IngredientStrip from '../components/sections/IngredientStrip.astro';
import MenuCard from '../components/sections/MenuCard.astro';
import MenuGrid from '../components/sections/MenuGrid.astro';
import SectionOpener from '../components/sections/SectionOpener.astro';
import VisitBlock from '../components/sections/VisitBlock.astro';
import site from '../content/site.json';
import Layout from '../layouts/Layout.astro';
import { getMenu } from '../lib/menu';
import kulchaPair from '../assets/photos/kulcha-pair.jpg';
import kulcha from '../assets/photos/kulcha-plate.jpg';
import saag from '../assets/photos/sarson-ka-saag.jpg';
import skewers from '../assets/photos/tandoor-skewers.jpg';

// Dishes, prices and descriptions come from src/content/menu.ts, which follows the printed menu card.
const chapters = await getMenu();
const siteUrl = Astro.site ?? new URL(Astro.url.origin);
const count = chapters.reduce((n, c) => n + c.items.length, 0);

// The sub-nav names nine courses; each jumps to the first POS chapter of that course. A course whose chapter is missing is left out.
const courses = [
  ['Chaat', 'chaats'],
  ['Tandoor', 'vegetarian-entrees'],
  ['Curries', 'vegetarian-mains'],
  ['Specials', 'amritsari-specials'],
  ['Kulcha', 'kulchas-stuffed-breads'],
  ['Breads', 'breads'],
  ['Rice', 'biryani'],
  ['Sweets', 'desserts'],
  ['Drinks', 'drinks'],
].filter(([, id]) => chapters.some((c) => c.id === id));

// Ingredient strips open these chapters, breaking the long read into courses.
const strips: Record<string, ImageMetadata> = { 'non-vegetarian-entrees': skewers, 'vegetarian-mains': saag, 'kulchas-stuffed-breads': kulchaPair };

// The whole menu as schema.org Menu, so Google can read every dish, its price and dietary note.
const menuSchema = {
  '@context': 'https://schema.org',
  '@type': 'Menu',
  name: `${site.name} menu`,
  url: new URL('/menu', siteUrl).href,
  inLanguage: 'en-AU',
  hasMenuSection: chapters.map((c) => ({
    '@type': 'MenuSection',
    name: c.title,
    ...(c.deck ? { description: c.deck } : {}),
    hasMenuItem: c.items.map((d) => ({
      '@type': 'MenuItem',
      name: d.name,
      ...(d.desc ? { description: d.desc } : {}),
      ...(d.sizes && d.sizes.length > 1
        ? { offers: d.sizes.map((s) => ({ '@type': 'Offer', name: s.name, price: s.price, priceCurrency: 'AUD' })) }
        : d.amount
          ? { offers: { '@type': 'Offer', price: d.amount, priceCurrency: 'AUD' } }
          : {}),
      ...(d.veg ? { suitableForDiet: 'https://schema.org/VegetarianDiet' } : {}),
    })),
  })),
};
---

<Layout
  nav="overlay"
  title="Menu: Kulcha, Tandoori, Curries & Chaat"
  description={`Our full menu of ${count} Punjabi dishes with prices: Amritsari kulcha, tandoori, dal makhni, butter chicken, momo, biryani and lassi. Veg dishes marked.`}
  crumb="Menu"
  share={kulcha}
  schema={[menuSchema]}
>
  <Hero
    image={kulcha}
    alt="A charred Amritsari kulcha topped with white butter, beside a tray of dark chole"
    welcome
    eyebrow={`${chapters.length} chapters · ${count} dishes`}
    title="The Menu"
    standfirst="Read it like a magazine: street chaat to begin, the tandoor in the middle, lassi and something sweet to close."
  />

  <nav class="courses surface-primary" aria-label="Menu courses">
    <div class="container courses__bar">
      <ul class="courses__list" role="list">
        {courses.map(([label, id]) => <li><a class="text-body-sm" href={`#${id}`}>{label}</a></li>)}
      </ul>
      <label class="courses__veg text-body-sm">
        <input type="checkbox" data-veg-toggle />
        <span>Veg only</span>
      </label>
    </div>
  </nav>

  {chapters.map((c) => (
    <>
      {strips[c.id] && <IngredientStrip image={strips[c.id]} />}
      <section class="section chapter" id={c.id} aria-labelledby={`${c.id}-title`} data-all-meat={c.items.every((d) => !d.veg) ? '' : undefined}>
        <div class="container">
          <SectionOpener eyebrow={c.kicker} title={c.title} standfirst={c.deck} size="md" id={`${c.id}-title`} />
          <MenuGrid>
            {c.items.map((dish) => <MenuCard dish={dish} />)}
          </MenuGrid>
        </div>
      </section>
    </>
  ))}

  <section class="allergens surface-sunken" aria-labelledby="allergens-title">
    <div class="container allergens__inner">
      <h2 id="allergens-title" class="text-heading-sm">Allergens &amp; dietary notes</h2>
      <p class="text-body-sm">Please tell us about any allergies when you order. Our kitchen handles nuts, dairy and gluten, so we cannot promise any dish is free of them. Dishes marked <span class="text-meta allergens__veg">Veg</span> are vegetarian. Dishes and availability may change.</p>
    </div>
  </section>

  <VisitBlock />
</Layout>

<script>
  const toggle = document.querySelector<HTMLInputElement>('[data-veg-toggle]');
  toggle?.addEventListener('change', () => document.documentElement.toggleAttribute('data-veg-only', toggle.checked));
</script>

<style>
  /* The course bar sticks under the solid nav. */
  .courses { position: sticky; top: var(--nav-height); z-index: 30; border-bottom: 1px solid var(--line-primary); }
  .courses__bar { display: flex; align-items: center; gap: var(--space-5); }
  .courses__list { display: flex; gap: var(--space-5); overflow-x: auto; scrollbar-width: none; flex: 1; mask-image: linear-gradient(to right, var(--ink-primary) 90%, transparent); }
  .courses__list::-webkit-scrollbar { display: none; }
  .courses__list a { display: inline-flex; align-items: center; justify-content: center; min-height: 52px; min-width: var(--touch-target); color: var(--ctx-ink); font-weight: var(--weight-medium); white-space: nowrap; text-decoration: underline; text-decoration-color: transparent; text-underline-offset: 0.5em; transition: text-decoration-color var(--duration-fast) var(--ease-out); }
  .courses__list a:hover { text-decoration-color: var(--ctx-ornament); }
  @media (min-width: 1024px) { .courses__list { mask-image: none; } }
  /* The filter needs JavaScript, so it only shows when JavaScript runs. */
  .courses__veg { display: none; flex: none; align-items: center; gap: var(--space-2); min-height: var(--touch-target); font-weight: var(--weight-medium); cursor: pointer; }
  :global(.js) .courses__veg { display: inline-flex; }
  .courses__veg input { width: 20px; height: 20px; margin: 0; accent-color: var(--brand-emerald); }
  /* html already pads anchor jumps by the nav's height; this adds the course bar's. */
  .chapter { scroll-margin-top: 52px; }
  .chapter + .chapter { padding-top: 0; }
  .allergens { padding-block: var(--space-8); }
  .allergens__inner { display: grid; gap: var(--space-3); max-width: 760px; text-align: center; justify-items: center; }
  .allergens__veg { color: var(--brand-emerald); }
  :global(html[data-veg-only] [data-nonveg]),
  :global(html[data-veg-only] [data-all-meat]) { display: none; }
</style>
