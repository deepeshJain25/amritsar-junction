---
import Photo from '../components/Photo.astro';
import Todo from '../components/Todo.astro';
import Hero from '../components/sections/Hero.astro';
import SectionOpener from '../components/sections/SectionOpener.astro';
import Button from '../components/ui/Button.astro';
import Input from '../components/ui/Input.astro';
import site from '../content/site.json';
import Layout from '../layouts/Layout.astro';
import { confirmed } from '../lib/seo';
import bhurji from '../assets/photos/paneer-bhurji.jpg';
import kulchaChole from '../assets/photos/kulcha-chole.jpg';

const formats = [
  {
    name: 'Party trays',
    kicker: 'Picked up or delivered',
    min: '[10]',
    price: '[$00 per head]',
    for: 'Birthdays, house parties, office lunches and family get-togethers.',
    includes: ['Choice of 2 curries from the menu', 'Dal makhani or dal tadka', 'Jeera rice or pulao', 'Naan, roti or lacha paratha', 'Raita, salad and pickle'],
  },
  {
    name: 'Full functions',
    kicker: 'Weddings and celebrations',
    min: '[50]',
    price: '[$00 per head]',
    for: 'Weddings, engagements, sangeet nights, Diwali and Lohri.',
    includes: ['Chaat counter: pani puri, papdi chaat, aloo tikki', '3 tandoori starters', 'Amritsari chole, dal makhani and 3 more curries', 'Biryani, rice and a bread basket with kulchas', 'Gulab jamun, rasmalai and masala chai'],
  },
  {
    name: 'Kirtan & community',
    kicker: 'Gurdwara, kirtan and seva',
    min: '[25]',
    price: '[$00 per head]',
    for: 'Kirtans, akhand path bhog, gurpurab and community gatherings.',
    includes: ['A fully vegetarian menu', 'No onion or garlic on request', 'Dal, chole, palak paneer and malai kofta', 'Rice, roti or fresh kulchas', 'Rasmalai or gulab jamun, and masala chai'],
  },
];

const samples = [
  {
    id: 'veg',
    label: 'Vegetarian',
    courses: [
      ['To begin', 'Papdi chaat, aloo tikki, tandoori paneer tikka, soya chap tikka'],
      ['Mains', 'Dal makhani, Amritsari chole, paneer tikka butter masala, sarson ka saag in winter'],
      ['Rice and bread', 'Jeera rice, Amritsari kulchas, butter naan'],
      ['Sweet', 'Gulab jamun, rasmalai'],
    ],
  },
  {
    id: 'mixed',
    label: 'Mixed',
    courses: [
      ['To begin', 'Amritsari fish, tandoori chicken tikka, malai paneer tikka'],
      ['Mains', 'Butter chicken, dal makhni, Amritsari chole, kadai paneer'],
      ['Rice and bread', 'Chicken biryani, butter naan, lacha paratha'],
      ['Sweet', 'Gulab jamun, rasmalai'],
    ],
  },
];

const faqs = [
  { q: 'How many guests is the minimum for catering?', a: 'Party trays start at [10] guests, kirtan and community menus at [25] and full functions at [50]. For smaller groups, our regular menu is available for takeaway.' },
  { q: 'How much notice do you need?', a: 'We ask for at least [3 days] for party trays, and [3 to 4 weeks] for weddings and large functions.' },
  { q: 'Can we change the dishes in a package?', a: 'Yes. Every package can be changed to suit your guests: swap dishes, add a sweet, or go fully vegetarian.' },
  { q: 'Can you cater for vegetarian, Jain or gluten-free guests?', a: 'Yes. More than half of our menu is vegetarian, and we can plan a fully vegetarian menu [and no onion or garlic (Jain) dishes on request]. Tell us about allergies when you enquire and we will advise on each dish.' },
  { q: 'Do you deliver and set up?', a: 'We deliver across [areas you deliver to]. For functions we can provide [chafing dishes, serving staff and setup] on request.' },
  { q: 'How do we confirm a booking?', a: '[Deposit and payment terms.]' },
];

const faqSchema = {
  '@context': 'https://schema.org',
  '@type': 'FAQPage',
  mainEntity: faqs
    .filter((f) => confirmed(f.a))
    .map((f) => ({ '@type': 'Question', name: f.q, acceptedAnswer: { '@type': 'Answer', text: f.a } })),
};
---

<Layout
  nav="overlay"
  title="Indian & Punjabi Catering, Sydney"
  description="Punjabi catering for weddings, kirtans, parties and offices: party trays, full function menus and community menus with tandoori, chaat, curries and sweets."
  crumb="Catering & Events"
  share={kulchaChole}
  schema={faqSchema.mainEntity.length ? [faqSchema] : []}
>
  <Hero
    image={kulchaChole}
    alt="A stack of tandoor-baked kulchas with a bowl of chole behind"
    eyebrow="Catering & events"
    title="Punjabi food, by the tray or by the function"
    standfirst="From a tray of butter chicken for the office to a full wedding spread with a chaat counter, we cook for ten guests or a whole hall."
  >
    <Button slot="actions" href="#enquire">Send an enquiry</Button>
    <Button slot="actions" variant="secondary" href={site.phoneHref}>Call us</Button>
  </Hero>

  <section class="section" aria-labelledby="formats-title">
    <div class="container">
      <SectionOpener eyebrow="Three ways to cater" title="Choose your spread" standfirst="Every format can be changed to suit your guests." id="formats-title" />
      <ul class="formats" role="list">
        {formats.map((f) => (
          <li class="format">
            <p class="eyebrow text-meta">{f.kicker}</p>
            <h3 class="text-heading-md">{f.name}</h3>
            <p class="text-body-sm format__for">{f.for}</p>
            <dl class="format__facts">
              <div><dt class="text-meta">Minimum</dt><dd class="text-tabular"><Todo text={f.min} /> guests</dd></div>
              <div><dt class="text-meta">From</dt><dd class="text-tabular"><Todo text={f.price} /></dd></div>
            </dl>
            <ul class="format__includes text-body-sm" role="list">
              {f.includes.map((line) => <li>{line}</li>)}
            </ul>
          </li>
        ))}
      </ul>
    </div>
  </section>

  <section class="section surface-sunken" aria-labelledby="samples-title">
    <div class="container">
      <SectionOpener eyebrow="Sample menus" title="What a spread looks like" size="md" align="center" id="samples-title" />
      <div class="samples" data-tabs>
        <div class="samples__tabs" role="tablist" aria-label="Sample menus">
          {samples.map((s, i) => (
            <button class="samples__tab" type="button" role="tab" id={`tab-${s.id}`} aria-controls={`panel-${s.id}`} aria-selected={i === 0 ? 'true' : 'false'} tabindex={i === 0 ? 0 : -1}>{s.label}</button>
          ))}
        </div>
        {samples.map((s) => (
          <div class="samples__panel" role="tabpanel" id={`panel-${s.id}`} aria-labelledby={`tab-${s.id}`}>
            <h3 class="text-heading-md samples__heading">{s.label}</h3>
            <dl class="samples__courses">
              {s.courses.map(([course, dishes]) => (
                <div><dt class="eyebrow text-meta">{course}</dt><dd class="text-body">{dishes}</dd></div>
              ))}
            </dl>
          </div>
        ))}
      </div>
    </div>
  </section>

  <section class="section" id="enquire" aria-labelledby="enquire-title">
    <div class="container enquire">
      <div class="enquire__media">
        <Photo src={bhurji} alt="Paneer bhurji in a silver serving dish with red onion, tomato and lime" caption="Paneer bhurji, served family-style." aspect="4 / 5" radius="lg" sizes="(min-width: 1024px) 480px, 100vw" />
      </div>
      <div>
        <p class="eyebrow text-meta">Enquire</p>
        <h2 id="enquire-title" class="text-display-md">Tell us about your event</h2>
        <p class="text-body enquire__lede">We reply within <Todo text="[one business day]" /> with a menu suggestion and a quote. Prefer to talk? Call <a href={site.phoneHref}><Todo text={site.phone} /></a>.</p>
        <form class="form-grid" method="post" action="#enquire" data-form="catering">
          <Input label="Your name" name="name" id="c-name" autocomplete="name" />
          <Input label="Email" name="email" id="c-email" type="email" autocomplete="email" />
          <Input label="Phone" name="phone" id="c-phone" type="tel" autocomplete="tel" />
          <Input label="Event date" name="date" id="c-date" type="date" />
          <Input label="Guests" name="guests" id="c-guests" type="number" min="10" inputmode="numeric" />
          <Input label="Type of event" name="event_type" id="c-type" type="select">
            <option value="">Choose one</option>
            <option>Wedding or engagement</option>
            <option>Kirtan or religious function</option>
            <option>Birthday or family party</option>
            <option>Office or corporate</option>
            <option>Festival celebration</option>
            <option>Other</option>
          </Input>
          <Input label="Notes" name="notes" id="c-notes" type="textarea" optional full placeholder="Venue or suburb, favourite dishes, allergies, timing" />
          <div class="field--full"><Button type="submit">Send enquiry</Button></div>
        </form>
      </div>
    </div>
  </section>

  <section class="section faq-section" aria-labelledby="faq-title">
    <div class="container faq">
      <SectionOpener eyebrow="Questions" title="Catering, answered" size="md" id="faq-title" />
      <div class="faq__list">
        {faqs.map((f) => (
          <details class="faq__item">
            <summary class="text-heading-sm">{f.q}</summary>
            <p class="text-body"><Todo text={f.a} /></p>
          </details>
        ))}
      </div>
    </div>
  </section>
</Layout>

<script>
  // Tabs for the sample menus. Without JavaScript both menus show, one after the other.
  document.querySelectorAll<HTMLElement>('[data-tabs]').forEach((root) => {
    const tabs = [...root.querySelectorAll<HTMLButtonElement>('[role="tab"]')];
    const select = (tab: HTMLButtonElement) => {
      tabs.forEach((t) => {
        const on = t === tab;
        t.setAttribute('aria-selected', String(on));
        t.tabIndex = on ? 0 : -1;
        root.querySelector<HTMLElement>(`#${t.getAttribute('aria-controls')}`)!.hidden = !on;
      });
    };
    tabs.forEach((tab, i) => {
      tab.addEventListener('click', () => select(tab));
      tab.addEventListener('keydown', (e) => {
        const next = e.key === 'ArrowRight' ? tabs[(i + 1) % tabs.length] : e.key === 'ArrowLeft' ? tabs[(i - 1 + tabs.length) % tabs.length] : null;
        if (next) { next.focus(); select(next); }
      });
    });
    root.classList.add('is-tabbed');
    select(tabs[0]);
  });
</script>

<style>
  .formats { display: grid; grid-template-columns: minmax(0, 1fr); gap: var(--space-5); }
  @media (min-width: 1024px) { .formats { grid-template-columns: repeat(3, minmax(0, 1fr)); gap: var(--grid-gutter); } }
  .format { display: grid; align-content: start; gap: var(--space-3); padding: var(--space-6) var(--space-5); background: var(--surface-raised); border-radius: var(--radius-lg); box-shadow: var(--elev-inset); }
  .format .eyebrow { margin-bottom: 0; }
  .format__for { color: var(--ink-secondary); }
  .format__facts { display: flex; gap: var(--space-6); padding-block: var(--space-3); border-block: 1px solid var(--line-primary); }
  .format__facts dt { color: var(--brand-emerald); }
  .format__facts dd { margin: 0; }
  .format__includes { display: grid; gap: var(--space-2); }
  .format__includes li { display: flex; gap: var(--space-3); }
  .format__includes li::before { content: ""; flex: none; width: 6px; height: 6px; margin-top: 0.6em; background: var(--brand-gold); transform: rotate(45deg); }

  .samples { max-width: 760px; margin-inline: auto; }
  .samples__tabs { display: none; justify-content: center; gap: var(--space-2); margin-bottom: var(--space-7); }
  .samples.is-tabbed .samples__tabs { display: flex; }
  .samples.is-tabbed .samples__heading { display: none; }
  .samples__tab { min-height: var(--touch-target); padding: var(--space-2) var(--space-6); background: transparent; color: var(--ink-primary); border: 1px solid var(--brand-gold); border-radius: var(--radius-pill); font-weight: var(--weight-medium); transition: background-color var(--duration-fast) var(--ease-out); }
  .samples__tab:hover { background: var(--brand-gold-tint); }
  .samples__tab[aria-selected="true"] { background: var(--surface-inverse-warm); border-color: var(--surface-inverse-warm); color: var(--ink-on-inverse); }
  .samples__panel + .samples__panel { margin-top: var(--space-8); }
  .samples.is-tabbed .samples__panel + .samples__panel { margin-top: 0; }
  .samples__heading { margin-bottom: var(--space-5); text-align: center; }
  .samples__courses { display: grid; gap: var(--space-6); text-align: center; }
  .samples__courses dt { margin-bottom: var(--space-2); }
  .samples__courses dd { margin: 0; }

  .enquire { display: grid; grid-template-columns: minmax(0, 1fr); gap: var(--space-8); align-items: start; }
  @media (min-width: 1024px) { .enquire { grid-template-columns: 5fr 7fr; gap: var(--space-9); } }
  .enquire__lede { margin: var(--space-4) 0 var(--space-7); max-width: var(--measure-prose); }

  .faq-section { padding-top: 0; }
  .faq__list { max-width: 820px; border-top: 1px solid var(--line-primary); }
  .faq__item { border-bottom: 1px solid var(--line-primary); }
  .faq__item summary { display: flex; align-items: center; justify-content: space-between; gap: var(--space-5); min-height: 64px; padding-block: var(--space-4); cursor: pointer; list-style: none; }
  .faq__item summary::-webkit-details-marker { display: none; }
  .faq__item summary::after { content: "+"; flex: none; font-size: 1.5rem; font-weight: var(--weight-regular); color: var(--brand-gold); transition: transform var(--duration-base) var(--ease-in-out); }
  .faq__item[open] summary::after { transform: rotate(45deg); }
  .faq__item p { padding-bottom: var(--space-5); max-width: var(--measure-prose); color: var(--ink-secondary); }
</style>
