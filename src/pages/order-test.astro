---
import { RESTAURANT_ID, STOREFRONT_API_URL } from 'astro:env/server';
import OrderTest from '../components/OrderTest.tsx';
import Layout from '../layouts/Layout.astro';

// Internal test page for the POS ordering + Stripe flow. Not linked anywhere, kept out of the
// sitemap and marked noindex. Menu and payment settings are fetched live in the browser.
---

<Layout title="Order test" description="Internal test page for online ordering." crumb="Order test" noindex>
  <section class="container ot-head">
    <p class="eyebrow text-meta">Internal · Test page</p>
    <h1 class="text-display-lg">Order test</h1>
    <p class="text-body-lg">Pick quantities, enter your details and pay. Every API call is listed below the form. Use Stripe test card 4242 4242 4242 4242 with any future expiry and any CVC.</p>
  </section>
  <div class="container ot-body">
    <OrderTest client:only="react" apiUrl={STOREFRONT_API_URL} restaurantId={RESTAURANT_ID} />
  </div>
</Layout>

<style is:global>
  .ot-head { padding-top: var(--space-8); padding-bottom: var(--space-6); }
  .ot-head .text-body-lg { margin-top: var(--space-4); max-width: var(--measure-prose); color: var(--ink-secondary); }
  .ot-body { padding-bottom: var(--space-9); }
  .ot { display: grid; grid-template-columns: 1fr 1fr; gap: var(--space-8); align-items: start; }
  .ot-list { margin: var(--space-4) 0 0; padding: 0; list-style: none; border-top: 1px solid var(--line-primary); }
  .ot-row { display: flex; justify-content: space-between; align-items: center; gap: var(--space-4); padding: var(--space-4) 0; border-bottom: 1px solid var(--line-primary); }
  .ot-name { margin: 0 0 2px; font-family: var(--font-display); font-size: var(--text-heading-md); font-weight: var(--weight-medium); }
  .ot-row .text-caption { margin: 0; color: var(--ink-secondary); }
  .ot-flag { color: var(--brand-maroon); font-style: normal; }
  .ot-qty { display: flex; flex: none; align-items: center; gap: var(--space-2); }
  .ot-qty .btn { min-width: var(--touch-target); padding: 0; font-size: var(--text-heading-sm); }
  .ot-qty output { min-width: 2ch; text-align: center; font-variant-numeric: tabular-nums; }
  .ot-totals { margin: var(--space-5) 0 0; }
  .ot-totals div { display: flex; justify-content: space-between; padding: var(--space-1) 0; }
  .ot-totals dt { font-weight: var(--weight-medium); }
  .ot-totals dd { margin: 0; font-variant-numeric: tabular-nums; }
  .ot-total { margin-top: var(--space-2); padding-top: var(--space-2) !important; border-top: 1px solid var(--line-primary); font-size: var(--text-heading-sm); }
  .ot-pay .form-grid { margin-top: var(--space-4); }
  .ot-error { margin-top: var(--space-4); color: var(--state-error); }
  .ot-notice { margin: var(--space-4) 0 0; padding: var(--space-4); background: var(--surface-sunken); border-left: 3px solid var(--brand-gold); font-size: var(--text-body-sm); }
  .ot-done { margin-top: var(--space-5); padding: var(--space-4); border: 1px solid var(--brand-emerald); border-radius: var(--radius-md); }
  .ot-done p { margin: 0; }
  .ot-log { grid-column: 1 / -1; }
  .ot-log ol { margin: var(--space-4) 0 0; padding: 0; list-style: none; }
  .ot-log__item { margin-bottom: var(--space-4); padding: var(--space-3) var(--space-4); background: var(--surface-sunken); border-left: 3px solid var(--line-primary); }
  .ot-log__item.is-ok { border-color: var(--brand-emerald); }
  .ot-log__item.is-error { border-color: var(--brand-maroon); }
  .ot-log__item.is-warn { border-color: var(--brand-gold); }
  .ot-log__step { margin: 0; font-weight: var(--weight-medium); }
  .ot-log__step span { margin-left: var(--space-2); color: var(--ink-secondary); font-weight: var(--weight-regular); }
  .ot-log pre { margin: var(--space-2) 0 0; font-size: var(--text-body-sm); line-height: var(--leading-body-sm); white-space: pre-wrap; overflow-wrap: anywhere; }
  @media (max-width: 1023px) { .ot { grid-template-columns: 1fr; gap: var(--space-7); } }
  @media (max-width: 639px) { .ot-pay .form-grid { grid-template-columns: 1fr; } }
</style>
