---
import { RESTAURANT_ID, STOREFRONT_API_URL } from 'astro:env/server';
import OrderTest from '../components/OrderTest.tsx';
import Layout from '../layouts/Layout.astro';

// Internal test page for the POS ordering + Stripe flow. Not linked anywhere, kept out of the
// sitemap and marked noindex. Menu and payment settings are fetched live in the browser.
---

<Layout title="Order test" description="Internal test page for online ordering." crumb="Order test" noindex>
  <section class="aj-wrap ot-head">
    <span class="aj-kicker">Internal · Test page</span>
    <h1 class="aj-headline">Order test</h1>
    <p class="aj-deck">Pick quantities, enter your details and pay. Every API call is listed below the form. Use Stripe test card 4242 4242 4242 4242 with any future expiry and any CVC.</p>
  </section>
  <div class="aj-wrap ot-body">
    <OrderTest client:only="react" apiUrl={STOREFRONT_API_URL} restaurantId={RESTAURANT_ID} />
  </div>
</Layout>

<style is:global>
  .ot-head { padding-top: var(--space-6); padding-bottom: var(--space-4); }
  .ot-head .aj-kicker { display: block; margin-bottom: var(--space-2); }
  .ot-head .aj-deck { margin-top: var(--space-3); }
  .ot-body { padding-bottom: var(--space-7, 64px); }
  .ot { display: grid; grid-template-columns: 1fr 1fr; gap: var(--space-6); align-items: start; }
  .ot-list { list-style: none; margin: var(--space-3) 0 0; padding: 0; border-top: 3px solid var(--rule-strong); }
  .ot-row { display: flex; justify-content: space-between; align-items: center; gap: var(--space-3); padding: var(--space-3) 0; border-bottom: 1px solid var(--rule); }
  .ot-name { font-size: 19px; font-weight: 600; margin: 0 0 2px; }
  .ot-row .aj-caption { margin: 0; }
  .ot-flag { color: #8a4b00; font-style: normal; }
  .ot-qty { display: flex; align-items: center; gap: var(--space-2); flex: none; }
  .ot-qty .aj-btn { min-width: 44px; min-height: 44px; padding: 0; font-size: 20px; }
  .ot-qty output { min-width: 2ch; text-align: center; font-size: 19px; font-variant-numeric: tabular-nums; }
  .ot-totals { margin: var(--space-4) 0 0; }
  .ot-totals div { display: flex; justify-content: space-between; padding: var(--space-1) 0; }
  .ot-totals dt { font-family: var(--font-label); font-weight: 600; letter-spacing: .04em; }
  .ot-totals dd { margin: 0; font-variant-numeric: tabular-nums; }
  .ot-total { border-top: 1px solid var(--rule-strong); margin-top: var(--space-2); padding-top: var(--space-2) !important; font-size: 21px; }
  .ot-pay .aj-form { margin-top: var(--space-3); }
  .ot-card { padding: 14px var(--space-3); }
  .ot-error { color: #b3261e; margin-top: var(--space-3); }
  .ot-notice { background: var(--paper-deep); border-left: 3px solid var(--gold-ink); padding: var(--space-3); margin: var(--space-3) 0 0; font-size: 15px; }
  .ot-done { margin-top: var(--space-4); padding: var(--space-3); border: 1px solid var(--emerald, #0f3b2e); }
  .ot-done p { margin: 0; }
  .ot-log { grid-column: 1 / -1; }
  .ot-log ol { list-style: none; margin: var(--space-3) 0 0; padding: 0; }
  .ot-log__item { border-left: 3px solid var(--rule-strong); padding: var(--space-2) var(--space-3); margin-bottom: var(--space-3); background: var(--paper-deep); }
  .ot-log__item.is-ok { border-color: #2e7d32; }
  .ot-log__item.is-error { border-color: #b3261e; }
  .ot-log__item.is-warn { border-color: #c77700; }
  .ot-log__step { font-family: var(--font-label); font-weight: 600; margin: 0; }
  .ot-log__step span { font-weight: 400; color: var(--ink-muted); margin-left: var(--space-2); }
  .ot-log pre { margin: var(--space-2) 0 0; font-size: 13px; line-height: 1.45; white-space: pre-wrap; overflow-wrap: anywhere; }
  @media (max-width: 860px) { .ot { grid-template-columns: 1fr; gap: var(--space-5); } }
  @media (max-width: 720px) { .ot-pay .aj-form { grid-template-columns: 1fr; } }
</style>
