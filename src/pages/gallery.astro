---
import Photo from '../components/Photo.astro';
import { essays } from '../content/gallery';
import site from '../content/site.json';
import Layout from '../layouts/Layout.astro';
import kulcha from '../assets/photos/kulcha-thali.jpg';

const siteUrl = Astro.site ?? new URL(Astro.url.origin);
const gallerySchema = {
  '@context': 'https://schema.org',
  '@type': 'CollectionPage',
  name: `${site.name} gallery: the stories behind our dishes`,
  url: new URL('/gallery', siteUrl).href,
  hasPart: essays.map((e) => ({
    '@type': 'Article',
    headline: `${e.kicker}: ${e.title}`,
    description: e.deck,
    url: new URL(`/gallery#${e.id}`, siteUrl).href,
    image: e.photos.map((p) => new URL(p.src.src, siteUrl).href),
  })),
};
---

<Layout
  title="Gallery: The Stories Behind Our Dishes"
  description="A photo essay on the history and flavour of Amritsari kulcha, chole, tandoori kebabs, dal makhani, sarson ka saag, paneer bhurji and jalebi."
  crumb="Gallery"
  share={kulcha}
  schema={[gallerySchema]}
>
  <header class="aj-wrap aj-gal-head">
    <span class="aj-kicker">Gallery · A photo essay</span>
    <h1 class="aj-headline">Seven dishes, seven stories</h1>
    <p class="aj-deck">Where our food comes from, how it is made, and why it tastes the way it does.</p>
    <nav class="aj-gal-toc" aria-label="Stories in this essay">
      {essays.map((e, i) => <a href={`#${e.id}`}><span>{String(i + 1).padStart(2, '0')}</span> {e.kicker}</a>)}
    </nav>
  </header>

  {essays.map((e, i) => (
    <article
      id={e.id}
      class:list={['aj-essay', i % 2 === 1 && 'aj-deep']}
      aria-labelledby={`${e.id}-title`}
    >
      <div class:list={['aj-wrap', 'aj-spread', 'aj-spread--portrait', i % 2 === 1 && 'aj-spread--flip']}>
        <div class="aj-essay__photos">
          {e.photos.map((p, j) => (
            <Photo
              src={p.src}
              alt={p.alt}
              caption={p.caption}
              shape={j === 0 && p.src.height > p.src.width ? 'arch' : 'natural'}
              sizes="(max-width: 860px) 100vw, 42vw"
              eager={i === 0 && j === 0}
            />
          ))}
        </div>
        <div class="aj-essay__text">
          <span class="aj-kicker">{String(i + 1).padStart(2, '0')} · {e.kicker}{e.native && <> · <span lang="pa">{e.native}</span></>}</span>
          <h2 id={`${e.id}-title`} class="aj-headline">{e.title}</h2>
          <p class="aj-deck">{e.deck}</p>
          <hr class="aj-short" />
          {e.body.map((para, j) => <p class={j === 0 ? 'aj-dropcap' : undefined}>{para}</p>)}
        </div>
      </div>
    </article>
  ))}

  <section class="aj-band aj-story-gap" data-theme="marble" aria-labelledby="gal-cta">
    <div class="aj-wrap" style="text-align: center">
      <span class="aj-kicker">Hungry yet?</span>
      <h2 id="gal-cta" class="aj-headline" style="margin: var(--space-2) 0 var(--space-4)">Taste the stories</h2>
      <div class="aj-btn-row" style="justify-content: center">
        <a class="aj-btn aj-btn--primary" href={site.bookingUrl}>Reserve a table</a>
        <a class="aj-btn aj-btn--gilt" href="/menu">Read the menu</a>
      </div>
    </div>
  </section>
</Layout>

<style>
  .aj-gal-head { padding-top: var(--space-6); padding-bottom: var(--space-5); text-align: center; }
  .aj-gal-head .aj-kicker { display: block; margin-bottom: var(--space-3); }
  .aj-gal-head .aj-deck { margin: var(--space-3) auto 0; }
  .aj-gal-toc { display: flex; flex-wrap: wrap; justify-content: center; gap: var(--space-2) var(--space-4); margin-top: var(--space-5); padding: var(--space-3) 0; border-top: 3px solid var(--rule-strong); border-bottom: 1px solid var(--rule-strong); }
  .aj-gal-toc a { color: var(--ink); text-decoration: none; font-size: 17px; }
  @media (max-width: 720px) { .aj-gal-toc { display: grid; grid-template-columns: 1fr 1fr; gap: 0 var(--space-3); text-align: left; } .aj-gal-toc a { display: flex; align-items: center; gap: var(--space-1); min-height: 44px; } }
  .aj-gal-toc a:hover { color: var(--accent); text-decoration: underline; }
  .aj-gal-toc span { font-family: var(--font-label); font-size: 12px; font-weight: 600; color: var(--gold-ink); }
  .aj-essay { padding: var(--space-7) 0; scroll-margin-top: var(--space-3); }
  @media (max-width: 720px) { .aj-essay { padding: var(--space-6) 0; } }
  .aj-essay__photos { display: grid; gap: var(--space-5); }
  .aj-essay__text .aj-kicker { display: block; margin-bottom: var(--space-2); }
  .aj-essay__text .aj-deck { margin-top: var(--space-3); }
  .aj-essay__text p:not(.aj-deck) { max-width: var(--measure); }
</style>
